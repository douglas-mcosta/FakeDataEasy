{
  "manifest_version": 3,
  "name": "Fake Data Easy",
  "version": "2.3.0",
  "description": "Gera dados fictícios localmente (CPF, CNPJ, CEP, nome, GUID) para testar formulários. Atalhos Ctrl+Shift+1–4. Helper opcional só em sites que você autorizar; pode desligar nas opções. Sem anúncios, sem telemetria, sem envio de dados para a rede.",
  "minimum_chrome_version": "109",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Fake Data Easy",
    "default_icon": {
      "16": "assets/FakeDataEasy-16.png",
      "32": "assets/FakeDataEasy-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "gerar-cpf": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "Command+Shift+1"
      },
      "description": "Gerar e copiar CPF (só dígitos)",
      "global": true
    },
    "gerar-cnpj": {
      "suggested_key": {
        "default": "Ctrl+Shift+2",
        "mac": "Command+Shift+2"
      },
      "description": "Gerar e copiar CNPJ (só dígitos)",
      "global": true
    },
    "gerar-nome": {
      "suggested_key": {
        "default": "Ctrl+Shift+3",
        "mac": "Command+Shift+3"
      },
      "description": "Gerar e copiar nome (aleatório)",
      "global": true
    },
    "gerar-guid": {
      "suggested_key": {
        "default": "Ctrl+Shift+4",
        "mac": "Command+Shift+4"
      },
      "description": "Gerar e copiar GUID",
      "global": true
    },
    "abrir-menu-escolher": {
      "description": "Abrir menu Escolher no campo focado (helper). Atribua tecla em Atalhos da extensão.",
      "global": true
    }
  },
  "icons": {
    "16": "assets/FakeDataEasy-16.png",
    "32": "assets/FakeDataEasy-32.png",
    "48": "assets/FakeDataEasy-48.png",
    "128": "assets/FakeDataEasy-128.png"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "offscreen",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://localhost/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
