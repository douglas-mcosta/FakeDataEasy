{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["chrome", "node"],
    "isolatedModules": true,
    "useDefineForClassFields": true
  },
  "include": [
    "src/**/*.ts",
    "popup/**/*.ts",
    "pages/**/*.ts",
    "offscreen/**/*.ts",
    "vite.config.ts"
  ]
}
