{
  "name": "fakedataeasy-chrome-extension",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "Extensão Chrome — dados fictícios para testes (MV3, sem Angular)",
  "scripts": {
    "icons": "node scripts/generate-brand-icons.mjs",
    "build": "npm run icons && vite build && vite build --config vite.field-helper.config.ts",
    "dev": "concurrently -k \"vite build --watch\" \"vite build --config vite.field-helper.config.ts --watch\"",
    "zip": "npm run build && node scripts/zip-dist.mjs",
    "prints:normalize": "node scripts/normalize-print-screenshots.mjs"
  },
  "dependencies": {
    "gerador-nome": "^0.0.5",
    "js-brasil": "^2.6.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "archiver": "^7.0.1",
    "sharp": "^0.33.5",
    "concurrently": "^9.1.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.6"
  }
}
